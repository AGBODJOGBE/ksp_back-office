# Copier en .env.local pour le développement (jamais de vrai secret dans ce fichier).

# Adresse publique du site (liens absolus, plan du site, partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Gateway appelée par le navigateur. En production : https://api.ksp.bj
NEXT_PUBLIC_API_URL=http://localhost:3000

# Gateway appelée par le serveur Next.js (rendu des pages publiques).
# En production : adresse interne du cluster ; par défaut, la même que NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Adresses des autres sites de l'écosystème (liens croisés).
NEXT_PUBLIC_PORTAIL_URL=http://localhost:3010
NEXT_PUBLIC_SHOP_URL=http://localhost:3020
NEXT_PUBLIC_PRINT_URL=http://localhost:3030
